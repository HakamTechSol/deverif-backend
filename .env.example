PORT=5000

# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=verification_app
# DB_PORT=3306



JWT_SECRET=replace_with_64_byte_random_hex_secret
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_secret_for_refresh
JWT_EXPIRES_IN=30m
JWT_ISSUER=dverif-api
JWT_AUDIENCE=dverif-client

# Key used to AES-256-GCM encrypt sensitive person data (e.g. CNIC). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PERSON_DATA_ENCRYPTION_KEY=replace_with_64_char_random_hex_secret

UPLOAD_DIR=uploads

# Python document microservice (python-backend, port 5001): corrupt-file
# detection, OCR extraction and document matching. KEY MUST MATCH the one in
# python-backend/.env (DOC_SERVICE_API_KEY) or every call returns 401.
DOC_SERVICE_URL=http://localhost:5001
DOC_SERVICE_API_KEY=replace_with_the_same_long_random_string_as_python-backend_dot_env

PAYMENT_BASE_URL=http://localhost:5000
PAYMENT_FRONTEND_RETURN_URL=http://localhost:5173/payment/callback

BASIC_PLAN_AMOUNT=2500
BASIC_PLAN_DURATION_DAYS=30
PREMIUM_PLAN_AMOUNT=5000
PREMIUM_PLAN_DURATION_DAYS=30

# ── Payment gateway: Safepay (org-admin self-subscription checkout) ──
# TEST/SANDBOX ONLY. Never use LIVE mode with real credentials.
PAYMENT_GATEWAY_PROVIDER=safepay
PAYMENT_GATEWAY_MODE=test
PAYMENT_GATEWAY_PUBLIC_KEY=replace_with_safepay_public_key
PAYMENT_GATEWAY_SECRET_KEY=replace_with_safepay_secret_key
PAYMENT_GATEWAY_WEBHOOK_SECRET=replace_with_safepay_webhook_secret
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_PUBLIC_URL=http://localhost:5173

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_VERSION=1.1
JAZZCASH_TXN_TYPE=MWALLET
JAZZCASH_LANGUAGE=EN
JAZZCASH_CURRENCY=PKR
JAZZCASH_ACTION_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_SUB_MERCHANT_ID=
JAZZCASH_BANK_ID=
JAZZCASH_PRODUCT_ID=

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_PAYMENT_METHOD=MA_PAYMENT_METHOD
EASYPAISA_AUTO_REDIRECT=1
EASYPAISA_ACTION_URL=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf
EASYPAISA_HASH_FIELDS=amount,autoRedirect,emailAddr,expiryDate,mobileNum,orderRefNum,paymentMethod,postBackURL,storeId
EASYPAISA_HASH_MODE=key_and_pairs

APP_NAME=Dverif
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://dverif.com,https://www.dverif.com
FRONTEND_RESET_URL=http://localhost:5173/reset-password
RESET_PASSWORD_EXPIRES_IN=15m

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Display name shown next to the From address (e.g. "Dverif")
MAIL_FROM_NAME=
# Mailbox that receives replies to automated mail (defaults to SMTP_FROM)
MAIL_REPLY_TO=

# Receivers of contact / request-access lead notification emails (comma-separated)
LEAD_NOTIFICATION_RECIPIENTS=

# How many days back an org-admin may add manual attendance entries (default 7)
MANUAL_ATTENDANCE_MAX_AGE_DAYS=7

# DEV ONLY: let loopback addresses (::1/127.0.0.1) bypass the attendance IP
# allow-list so check-in can be tested from a local dev server. Never enable
# this in production — behind Apache/nginx real client IPs arrive via
# X-Forwarded-For and the allow-list applies normally.
# ALLOW_LOOPBACK_ATTENDANCE=true
